# API settings
APP_ENV=local
LOG_LEVEL=INFO
API_TITLE=Azure RAG Platform API
API_VERSION=0.1.0
OTEL_SERVICE_NAME=rag-api
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Model provider settings
EMBEDDING_PROVIDER=google
LLM_PROVIDER=google

# Local Ollama fallback settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Google AI Studio / Gemini settings
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=768

# Local Qdrant settings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=768
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Worker settings
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;
INGESTION_QUEUE_NAME=documents-to-ingest
DOCUMENTS_CONTAINER_NAME=documents
DOCUMENT_METADATA_TABLE_NAME=DocumentMetadata
WORKER_RETRY_LIMIT=5
AzureFunctionsJobHost__extensions__queues__maxDequeueCount=5
AzureFunctionsJobHost__extensions__queues__visibilityTimeout=00:00:30
DOCUMENT_CHUNK_MAX_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=200

# Docker Compose local services
API_PORT=8000
WORKER_PORT=7071
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
COMPOSE_AZURE_WEBJOBS_STORAGE=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
